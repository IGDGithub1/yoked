# Line endings, pinned.
#
# core.autocrlf is true on the dev machine, so every checkout rewrites LF to CRLF and every
# commit prints a wall of "LF will be replaced by CRLF" warnings. Noise mostly, but not
# only: bin/deploy.ps1 tarballs the working tree and ships it to Linux, so a shell script
# checked out with CRLF arrives with CRLF and dies on `#!/bin/sh\r`. Pinning the text files
# to LF in the working tree makes the deployed bytes match the committed ones.

# Everything text-ish gets LF, both in the repo and on disk.
*.php   text eol=lf
*.sql   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
*.htaccess text eol=lf

# PowerShell is the exception: it runs on Windows only, and CRLF is what its tooling and
# editors expect.
*.ps1   text eol=crlf

# Binary, never touched.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ico   binary
