# Yoked — public web root (SiteGround / Apache)
# Carried over from Friendspace: the cache rules below are the fix for the
# "users do not see updates" problem, so do not relax them.
# See ROADMAP_NOTES in that project for the history.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # API → PHP front controller
    RewriteRule ^api(/.*)?$ api/index.php [L,QSA]
    # SPA fallback: non-file, non-API → index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

# A note on the service worker, because it looks like a mistake and is not:
# the app registers /sw.php, not /sw.js.
#
# SiteGround puts nginx in front of Apache, and nginx serves common static
# extensions (.js among them) straight off disk with its own one-year Expires
# header -- Apache is never consulted, so no .htaccess rule here can touch a
# /sw.js request. Rewriting ^sw\.js$ does not help either: nginx matches the
# request URI before Apache ever sees it. (Proven with curl -I -- responses
# Apache handled carry X-Httpd-Modphp; the /sw.js response did not, and kept
# nginx's own ETag format.)
#
# A service worker pinned for a year cannot be recalled, and it governs every
# other cache, so it is worth the one exception: sw.php reads sw.js off disk and
# sets Cache-Control plus Service-Worker-Allowed: / itself. The file on disk
# stays .js so editors and linters treat it as JavaScript.

# Hashed build assets can be cached hard; index.html must not be.
#
# Note which of these rules actually take effect. nginx serves .js/.css/images/
# fonts itself with its own one-year Expires, so those FilesMatch blocks are
# belt-and-braces for when Apache does answer (and correct either way, because
# everything they match is content-hashed or effectively immutable). The rules
# that genuinely do work here are the ones for extensions nginx passes through:
# .html and .webmanifest. /sw.js needs the PHP hop above.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|gif|webp|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.webmanifest$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
