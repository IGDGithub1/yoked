# Copy to bin/deploy.env (gitignored) and fill in.
# Contains no secrets — the SSH key is referenced by path, and DB credentials
# live in src/config.php on the server.

SG_HOST=ssh.lil-boxes.com
SG_USER=SG_USER
SG_PORT=18765

# Application root — the directory CONTAINING public_html, not public_html
# itself. src/, database/, bin/ and storage/ must sit above the web root or
# they are fetchable over HTTP.
SG_APP_DIR=/home/customer/www/yoked.lil-boxes.com

# Private key for deploys. Generate with:
#   ssh-keygen -t ed25519 -f ~/.ssh/yoked_sg -C "yoked-deploy" -N ""
# then import the .pub into Site Tools → Devs → SSH Keys Manager.
SG_SSH_KEY=$HOME/.ssh/yoked_sg
